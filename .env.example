# Pineo: copy this file to .env (cp .env.example .env) and fill in the values yourself.
# .env is git-ignored. Never commit it, never paste a key into a chat.

# Deepgram key from the organisers (speech to text; the Vexo kit's speech.py reads this name).
DEEPGRAM_API_KEY=

# MiniMax API key from the MiniMax OpenPlatform console (platform.minimax.io).
MINIMAX_API_KEY=
# MiniMax OpenAI-compatible endpoint (non-secret default, platform.minimax.io/docs/api-reference/text-openai-api).
MINIMAX_BASE_URL=https://api.minimax.io/v1
# MiniMax Anthropic-compatible endpoint, for the coding agent (platform.minimax.io/docs/api-reference/text-anthropic-api).
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MiniMax model id (docs list MiniMax-M3.1-Flash as recommended; MiniMax-M3 also available).
MINIMAX_MODEL=MiniMax-M3.1-Flash
# Optional: GroupId from the console. The OpenAI/Anthropic-compatible APIs do not require it.
# MINIMAX_GROUP_ID=

# Team's band number, written on the band's bag (1-999). Never guess it.
PINEO_BAND_NUMBER=

# Optional: only for the kit's own OpenAI examples (check_keys.py, ai.py). Pineo uses MiniMax.
# OPENAI_API_KEY=

# Optional Deepgram tuning for the voice process (both off when unset: the kit's settings are used).
# How long a pause ends a sentence, in ms (kit default 100; 300 cuts fewer sentences in the middle).
# PINEO_DG_ENDPOINTING=300
# Words Deepgram should expect, separated by commas (product and component names).
# PINEO_DG_KEYTERMS=Larkspur,headline,pricing card,footer
